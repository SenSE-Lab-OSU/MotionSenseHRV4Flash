menuconfig QSPI_NOR_CUSTOM_DRIVER
	bool "custom sensor"
    default n
	select FLASH_HAS_DRIVER_ENABLED
	select NRFX_QSPI
	select FLASH_JESD21
	

menuconfig DISK_DRIVER_RAW_NAND
    bool
    prompt "NAND Disk for file storage with SENSE lab Simplified FTL. Allows buffered writing but does not support partial erases."
    default n


menuconfig RAW_NAND_BAD_BLOCK_SAVING
    bool
    prompt "Allows bad blocks to be registered in a memory array that is persisted across reboots."
    default n
    help
       Not currently enabled since our Custom Sense FTL does not support block reallocation.
       Pick where the table is kept with RAW_NAND_BAD_BLOCK_STORAGE below.
       See bad_block_detect_limit in bad_block.c for how large the table is.

if RAW_NAND_BAD_BLOCK_SAVING

choice RAW_NAND_BAD_BLOCK_STORAGE
    prompt "Where the bad block table is persisted"
    default RAW_NAND_BAD_BLOCK_STORAGE_NOR
    help
       The two backends are not interchangeable on a device that already has a
       table stored: switching re-runs the one time manufacturer bad block scan.

config RAW_NAND_BAD_BLOCK_STORAGE_NOR
    bool "External NOR flash, through the flash API"
    help
       Keeps the table in one sector of the external NOR just past the file table.
       Needs no extra partition, so the partition map stays identical to devices
       already in the field and they can still be updated over DFU. This is the
       original storage method.

config RAW_NAND_BAD_BLOCK_STORAGE_SETTINGS
    bool "Settings subsystem (NVS on internal flash)"
    select SETTINGS
    help
       Keeps the table in the settings subsystem. This requires Partition Manager
       to allocate a settings_storage partition, which changes the partition map:
       devices flashed with the older map cannot be updated to such a build over
       DFU. Prefer the NOR backend unless the internal flash is wanted for this.

endchoice

endif # RAW_NAND_BAD_BLOCK_SAVING

config RAW_NAND_ALLOW_RUNTIME_READONLY_FS
	bool "allows the file system to be set as read only during runtime (via set_read_only)"
	default n
	help
	   Dynamically allows the file system when using the NAND driver not allow any writes by calling the function set_read_only.
	    Note that this is a system that will only work at the internal software level: the drive is not actually readonly
		on windows, to do this, the drive must instead be mounted as readonly vs fs_mount. 

config BAD_BLOCK_SAVING_RUNTIME
    bool 
    prompt "Allows bad blocks to be registered in a memory array dynamically whenever the ECC flags it and not only during bad block detection"
    default n

menuconfig DISK_DRIVER_DHARA
    bool
    prompt "Disk Driver using dhara as the flash translation layer, instead of the SENSE lab custom nor solution."
    select BAD_BLOCK_SAVING_RUNTIME
    help
        uses Dhara's virtual addressing to handle bad blocks, wear leveling, and sector erasing
        for the current nand driver.

menuconfig SPI_NOR_CUSTOM_DRIVER
    bool
    prompt "Custom spi NOR driver, modified from spi_nor.c to be more generic and customizable."
    default n