/* Native USB command and diagnostic shell. */
/ {
	chosen { zephyr,shell-uart = &cdc_acm_uart0; };
};
zephyr_udc0: &usbd {
	status = "okay";
	cdc_acm_uart0: cdc-acm-uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&usbreg { status = "okay"; };

/* CONFIG_SPI=n leaves SPIM3 to the application HAL. Keep the node enabled
 * so Nordic pinctrl includes SPIM pin routing; retain the CS boot hog. */
&spi3 { status = "okay"; };
&fpga {
	status = "okay";
	spi-max-frequency = <8000000>;
};

/* Expose BTN_A/BTN_B without input handlers or application actions. */
&{/buttons} { status = "okay"; };
