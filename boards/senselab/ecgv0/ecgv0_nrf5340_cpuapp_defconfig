# Enable the core architecture features required by the nRF5340 application
# core. The SoC package itself is selected in Kconfig.ecgv0.
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_ARM_TRUSTZONE_M=y
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# ECGv0 receives an external 32.768 kHz clock. These settings require the
# documented NCS v2.9.3 LFXO bypass patch retained by this repository.
CONFIG_SOC_ENABLE_LFXO=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_20PPM=y
CONFIG_SOC_LFXO_CAP_EXTERNAL=y
CONFIG_SOC_LFXO_BYPASS=y

# Both SenseLab products use the same HFXO crystal and capacitor setting.
CONFIG_SOC_HFXO_CAP_INTERNAL=y
CONFIG_SOC_HFXO_CAP_INT_VALUE_X2=25
