# Enable the core architecture features required by the nRF5340 application
# core. The SoC package itself is selected in Kconfig.ppgv2.
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_ARM_TRUSTZONE_M=y
CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# PPGv2 has a 32.768 kHz crystal. Keep its established 9 pF internal LFXO
# capacitance and do not put the oscillator into external-clock bypass mode.
CONFIG_SOC_ENABLE_LFXO=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_SOC_LFXO_BYPASS=n
CONFIG_SOC_LFXO_CAP_INT_9PF=y

# Both SenseLab products use the same HFXO crystal and capacitor setting.
CONFIG_SOC_HFXO_CAP_INTERNAL=y
CONFIG_SOC_HFXO_CAP_INT_VALUE_X2=25
