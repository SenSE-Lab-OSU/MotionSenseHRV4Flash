# Enable the core architecture features needed by the HCI IPC network image.
# The SoC package itself is selected in Kconfig.ppgv2.
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y

# The network core shares the PPGv2 32.768 kHz crystal and HFXO hardware.
CONFIG_SOC_ENABLE_LFXO=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_SOC_LFXO_BYPASS=n
CONFIG_SOC_LFXO_CAP_INT_9PF=y
CONFIG_SOC_HFXO_CAP_INTERNAL=y
CONFIG_SOC_HFXO_CAP_INT_VALUE_X2=25
